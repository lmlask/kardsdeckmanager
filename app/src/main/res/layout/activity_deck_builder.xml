<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#404040"
    android:layout_height="match_parent"
    android:theme="@style/AppTheme"
    android:id="@+id/builder_parent"
    tools:context=".DeckBuilderActivity">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/builder_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="5dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/deckbuilder_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#202020" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/builder_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#202020"
                app:tabIndicatorColor="@android:color/holo_orange_dark"
                app:tabRippleColor="#505050"
                app:tabSelectedTextColor="@android:color/holo_orange_dark"
                app:tabTextAppearance="@style/MyCustomTabText"/>

        </com.google.android.material.appbar.AppBarLayout>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/builder_drawer_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/builder_appbarlayout">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/builder_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="?actionBarSize"
                app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_bar_container"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_alignParentBottom="true"
                android:layout_gravity="bottom"
                android:clickable="true"
                android:elevation="5dp"
                app:layout_constraintTop_toBottomOf="@+id/builder_view_pager"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:ignore="KeyboardInaccessibleWidget">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#202020"
                    tools:ignore="ContentDescription" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.33" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.66" />

                <ImageView
                    android:id="@+id/main_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/japan_unselected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toStartOf="@+id/main_count"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/main_count"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="5dp"
                    android:text="30"
                    android:textAlignment="center"
                    android:textColor="#D3D1C3"
                    android:textStyle="bold"
                    app:autoSizeStepGranularity="2dp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/guideline2"
                    app:layout_constraintStart_toEndOf="@+id/main_image"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ally_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/germany_unselected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toStartOf="@+id/ally_count"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="@+id/guideline2"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/ally_count"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="5dp"
                    android:text="10"
                    android:textAlignment="center"
                    android:textColor="#D3D1C3"
                    android:textStyle="bold"
                    app:autoSizeStepGranularity="2dp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/guideline3"
                    app:layout_constraintStart_toEndOf="@+id/ally_image"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/total_count"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="5dp"
                    android:text="10/40"
                    android:textAlignment="center"
                    android:textColor="#D3D1C3"
                    android:textStyle="bold"
                    app:autoSizeStepGranularity="2dp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/imageView"
                    app:layout_constraintStart_toStartOf="@+id/guideline3"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fab_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/builder_view_pager"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:onClick="finishHandler"
                android:scaleType="fitXY"
                android:src="@drawable/ic_save"
                app:fab_colorNormal="@android:color/holo_orange_dark"
                app:fab_colorPressed="@android:color/holo_orange_dark"
                app:fab_colorRipple="@android:color/holo_orange_light"
                app:fab_label=""
                app:fab_showShadow="true"
                app:layout_constraintBottom_toTopOf="@+id/bottom_bar_container"
                app:layout_constraintEnd_toEndOf="@id/bottom_bar_container" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/drawer_builder"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#202020"
            android:clickable="true"
            android:elevation="5dp"
            android:padding="10dp"
            tools:ignore="KeyboardInaccessibleWidget">

            <ToggleButton
                android:id="@+id/filter_country1"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/usa_toggle_button_layout"
                android:onClick="filterCountry"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_country2"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_toEndOf="@id/filter_country1"
                android:background="@drawable/britain_toggle_button_layout"
                android:onClick="filterCountry"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_infantry"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_country1"
                android:layout_marginStart="20dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/infantry_toggle_button_layout"
                android:onClick="filterType"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_tank"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_infantry"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/tank_toggle_button_layout"
                android:onClick="filterType"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_artillery"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_tank"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/artillery_toggle_button_layout"
                android:onClick="filterType"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_fighter"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_artillery"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fighter_toggle_button_layout"
                android:onClick="filterType"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_bomber"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_fighter"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bomber_toggle_button_layout"
                android:onClick="filterType"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_order"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_bomber"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/order_toggle_button_layout"
                android:onClick="filterType"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_cm"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_order"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/cm_toggle_button_layout"
                android:onClick="filterType"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_k1"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_country1"
                android:layout_marginStart="20dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="20dp"
                android:layout_toEndOf="@id/filter_infantry"
                android:background="@drawable/k1_button_layout"
                android:onClick="filterKredits"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_k2"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_k1"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_toEndOf="@id/filter_infantry"
                android:background="@drawable/k2_button_layout"
                android:onClick="filterKredits"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_k3"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_k2"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_toEndOf="@id/filter_infantry"
                android:background="@drawable/k3_button_layout"
                android:onClick="filterKredits"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_k4"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_k3"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_toEndOf="@id/filter_infantry"
                android:background="@drawable/k4_button_layout"
                android:onClick="filterKredits"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_k5"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_k4"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_toEndOf="@id/filter_infantry"
                android:background="@drawable/k5_button_layout"
                android:onClick="filterKredits"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_k6"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_k5"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_toEndOf="@id/filter_infantry"
                android:background="@drawable/k6_button_layout"
                android:onClick="filterKredits"
                android:textOff=""
                android:textOn="" />

            <ToggleButton
                android:id="@+id/filter_k7"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@id/filter_k6"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_toEndOf="@id/filter_infantry"
                android:background="@drawable/k7_button_layout"
                android:onClick="filterKredits"
                android:textOff=""
                android:textOn="" />

        </RelativeLayout>

    </androidx.drawerlayout.widget.DrawerLayout>



</androidx.constraintlayout.widget.ConstraintLayout>

